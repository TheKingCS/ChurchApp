DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="a long random string used to sign session cookies"

# Optional: enables the "Continue with Google" button on /login and
# /signup. Leave both unset to hide it and use email/password only.
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") — see README for the exact
# redirect URI to register.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
